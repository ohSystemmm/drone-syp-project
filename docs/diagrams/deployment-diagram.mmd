graph TB
    %% Deployment - what runs where

    title["Deployment Architecture"]
    style title fill:none,stroke:none

    subgraph GCS ["Ground Control Station (PC/Laptop)"]
        
        subgraph PythonRT ["Python Runtime"]
            
            subgraph Backend_["Backend Services"]
                DC["DroneController"]
                WS["WebServer<br/>(FastAPI)"]
                AP["AutoPilot"]
                FR["FlightRecorder"]
                Tel["Telemetry"]
            end

            subgraph Vision_["Vision"]
                VW["VisionWorker"]
                YD["YOLO Detector"]
                PE["PositionEstimator"]
            end

        end

        subgraph BrowserRT ["Browser Runtime"]
            UI["React UI<br/>(Vite build)"]
        end

    end

    subgraph Drone["DJI Tello TT"]
        FC["Flight Controller"]
        Cam["Camera"]
    end

    subgraph Storage_["Storage (optional)"]
        ModelRegistry["Model Registry<br/>(Roboflow, S3, etc)"]
    end

    %% connections
    UI -->|HTTP POST| WS
    WS -->|commands| DC
    DC -->|UDP 8889| FC
    
    Cam -->|UDP 11111<br/>H.264| DC
    DC -->|frames| VW
    VW -->|YOLO| YD
    VW -->|pose| PE
    
    DC -->|mjpeg| WS
    WS -->|video endpoint| UI
    
    AP -->|RC values| DC
    FR -->|logging| DC
    Tel -->|poll| DC
    Tel -->|display| UI
    
    YD -->|load model| ModelRegistry