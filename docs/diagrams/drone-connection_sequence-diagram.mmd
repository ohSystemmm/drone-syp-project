sequenceDiagram
    autonumber
    actor User
    participant API as FastAPI
    participant DC as DroneController
    participant Tello as djitellopy
    participant Drone as Tello HW

    rect rgb(100, 180, 220)
    Note over User,Drone: Connect & Setup
    User->>API: POST /api/connect?ip=192.168.10.1
    API->>DC: connect(host, port)
    DC->>Tello: Tello(host)
    Tello->>Drone: "command" on UDP 8889
    Drone-->>Tello: "ok"
    
    DC->>Tello: set video config
    DC->>Tello: streamon()
    Tello->>Drone: streamon
    Drone-->>Tello: ok
    
    DC->>Tello: get_frame_read()
    Tello->>Drone: open UDP 11111
    Drone-->>Tello: H.264 stream starts
    
    DC->>DC: wait for first frame (4s timeout)
    DC-->>API: is_connected=True
    API-->>User: {status: connected, battery: 85}
    end

    rect rgb(150, 220, 150)
    Note over DC,Drone: Background Watchdog (every 3s)
    loop every 3 seconds
        DC->>Tello: get_battery()
        Tello->>Drone: battery?
        Drone-->>Tello: XX%
        Tello-->>DC: update ping time
        alt timeout > 10s
            DC->>DC: emergency_land()
            DC-->>API: connection lost!
        end
    end
    end

    rect rgb(220, 180, 100)
    Note over User,Drone: Flight Control Loop
    User->>API: POST /api/takeoff
    API->>DC: takeoff()
    DC->>DC: spawn async thread
    DC->>Tello: takeoff()
    Tello->>Drone: takeoff
    Drone-->>Tello: ok
    Tello-->>DC: is_flying=True
    API-->>User: {status: flying}
    
    loop autopilot or joystick RC
        User->>API: POST /api/rc?lr=0&fb=50&ud=0&yv=0
        API->>DC: send_rc_control(...)
        alt within rate limit (50ms)
            DC->>Tello: rc lr fb ud yv
            Tello->>Drone: rc command
        end
        Drone-->>Tello: sensor update
        Tello-->>DC: height/speed data
        DC-->>API: telem
        API-->>User: {battery: 80, height: 50cm}
    end

    User->>API: POST /api/land
    API->>DC: land()
    DC->>Tello: land()
    Tello->>Drone: land
    Drone-->>Tello: ok (descending...)
    Tello-->>DC: is_flying=False
    API-->>User: {status: landed}
    end

    rect rgb(200, 150, 220)
    Note over User,Drone: Disconnect
    User->>API: POST /api/disconnect
    API->>DC: disconnect()
    DC->>Tello: streamoff, close
    Tello->>Drone: (close sockets)
    API-->>User: {status: disconnected}
    end

