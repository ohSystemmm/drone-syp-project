flowchart TD
    Start(["Start"]) --> Conn["DroneController: streamon"]
    Conn --> GetReader["get_frame_read from djitellopy"]
    
    subgraph Drone_HW["Tello Hardware"]
        GetReader --> Capture["sensor captures frame"]
        Capture --> Encode["encode H.264"]
        Encode --> UDP_Stream["UDP 11111 packet stream"]
    end
    
    subgraph BG_Thread["djitellopy FrameReader Thread"]
        UDP_Stream --> Recv["receive packets"]
        Recv --> Reassemble["reassemble stream"]
        Reassemble --> PyAV["PyAV/FFmpeg decode"]
        PyAV --> Buffer["buffer latest frame"]
    end
    
    Buffer --> Lock{"frame available?"}
    
    subgraph Vision["VisionWorker Thread"]
        Lock -->|yes| V_Get["get_frame from DC"]
        V_Get --> V_RGB["RGB to BGR"]
        V_RGB --> V_YOLO["YOLO inference"]
        V_YOLO --> V_Pose["pose estimation"]
        V_Pose --> V_Store["store detections"]
    end
    
    subgraph Web["Web/Main Thread"]
        Lock -->|yes| W_Get["get_frame from DC"]
        W_Get --> W_Draw["draw boxes + OSD"]
        W_Draw --> W_JPEG["encode JPEG"]
        W_JPEG --> W_Send["send to browser<br/>WebSocket"]
        W_Send --> W_Record["(optional) record MP4"]
    end

    V_Store -.->|pose data| AP["AutoPilot"]
    AP -->|RC values| DC_["DroneController"]
    DC_ -->|UDP 8889| Drone_HW
    
    W_Send -->|video stream| Browser["React UI"]
    Browser -.->|user input| WebAPI["FastAPI /api/*"]
    WebAPI --> DC_
    
    W_Record --> End(["~30fps loop"])
    V_Store --> End

