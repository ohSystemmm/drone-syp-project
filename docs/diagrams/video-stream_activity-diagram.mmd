flowchart TD
    Start(["Start"]) --> Connect["Verbindung herstellen"]
    Connect --> StreamOn["Kommando streamon senden"]
    
    subgraph Drohne ["Drohne (DJI Tello)"]
        StreamOn --> Capture["Bildsensor erfasst Frame"]
        Capture --> Encode["Frame als H.264 encodieren"]
        Encode --> Transmit["UDP-Pakete über Wi-Fi senden"]
    end
    
    subgraph djitellopy ["Hintergrund-Thread djitellopy"]
        Transmit --> Receive["Pakete empfangen und zusammensetzen"]
        Receive --> Decode["PyAV decodiert Video-Stream"]
        Decode --> UpdateReader["Aktuellsten Frame in Speicher ablegen"]
    end
    
    UpdateReader --> SyncFork{"Verzweigung"}
    
    subgraph VisionWorker ["Vision-Thread"]
        SyncFork --> V_Get["DroneController.get_frame"]
        V_Get --> V_Conv["Umwandlung in BGR"]
        V_Conv --> V_YOLO["YOLO Objekterkennung"]
        V_YOLO --> V_Pose["Aruco Mask Posenschätzung"]
        V_Pose --> V_Store["Detections und Pose speichern"]
    end
    
    subgraph MainThread ["Main-Thread"]
        SyncFork --> M_Get["DroneController.get_frame"]
        M_Get --> M_Draw["Zeichne Erkennungen und OSD"]
        M_Draw --> M_Write["Frame in MP4-Datei schreiben"]
        M_Write --> M_Render["Frame auf Pygame-Display rendern"]
    end

    %% Datenfluss von Vision zu Main
    V_Store -.->|"Aktuelle Posen-Daten"| M_Draw

    V_Store --> SyncJoin{"Zusammenführung"}
    M_Render --> SyncJoin{"Zusammenführung"}
    
    SyncJoin -->|"Nächster Frame"| UpdateReader
    SyncJoin -->|"Programm beendet"| Ende(["Ende"])
