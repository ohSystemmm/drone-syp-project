graph TB
    %% component architecture - what runs on the GCS

    title["Drone Control System Components"]
    style title fill:none,stroke:none

    subgraph GCS ["Ground Control Station"]
        
        subgraph Backend["Backend (Python)"]
            
            subgraph Core["Core / Control"]
                DC["DroneController<br/>- djitellopy wrapper<br/>- handles UDP 8889/11111<br/>- frame reader thread"]
                AP["AutoPilot<br/>- PID loops for XY centering<br/>- Z distance control<br/>- state machine"]
                FR["FlightRecorder<br/>- logs RC commands to JSON<br/>- timing + intensity"]
                Tel["Telemetry<br/>- polls battery/height<br/>- background task"]
            end

            subgraph Vision["Vision Pipeline"]
                VW["VisionWorker<br/>- reads frames<br/>- spawns YOLO + pose"]
                YD["YOLO Detector<br/>- onnx/pt model<br/>- 0.5 conf threshold"]
                PE["PositionEstimator<br/>- Kalman filter<br/>- X/Y/Z from ArUco mask"]
                AC["ArUco Markers<br/>- marker detection<br/>- calibration fusion"]
            end

            subgraph Web["Web API"]
                WS["FastAPI<br/>- /api/connect<br/>- /api/takeoff<br/>- /api/rc<br/>- /api/video"]
            end

        end

        subgraph Frontend["Web Frontend"]
            UI["React SPA<br/>- video canvas<br/>- joystick controls<br/>- metric display"]
        end

    end

    subgraph Drone ["DJI Tello"]
        FC["Flight Controller<br/>(UDP 8889)"]
        Cam["Camera<br/>(H.264, UDP 11111)"]
    end

    subgraph Files["Disk"]
        Logs["flight_rec_*.json"]
        Models["targetModel.onnx"]
        Cfg["keybindings.json"]
    end

    %% flow
    DC -->|frames| VW
    VW -->|inference| YD
    VW -->|estimate ROI| PE
    PE -->|marker data| AC
    
    AP -->|computed RC| DC
    DC -->|UDP commands| FC
    FC -->|height/batt| DC
    
    Cam -->|UDP stream| DC
    DC -->|decoded| VW
    DC -->|mjpeg| WS
    WS -->|video endpoint| UI
    
    UI -->|POST /api/rc| WS
    WS -->|rc values| DC
    
    FR -->|write| Logs
    YD -->|load| Models
    UI -->|read| Cfg
    Tel -->|poll| DC
    Tel -->|metrics| UI