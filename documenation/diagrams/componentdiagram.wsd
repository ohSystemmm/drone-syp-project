@startuml
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false

title DJI Tello TT Autonomous Flight System (Kivy Architecture)

node "Hardware" {
    [DJI Tello TT Drone] as Tello
    [Gamepad / Joystick] as JoystickHardware
}

package "Frontend (Kivy GUI & OpenGL)" {
    [Kivy App / Clock Scheduler] as KivyApp
    [Video HUD Widget\n(Kivy Texture)] as HUD
    [Control Center UI\n(Kivy Layouts)] as ControlCenterUI
    [3D Room Widget\n(Kivy Canvas / GPU)] as Room3DWidget
}

package "Input Handling (Headless)" {
    [Headless Pygame\n(Event Pump)] as HeadlessPygame
    [Joystick Handler] as Joystick
}

package "Core Integration" {
    [Drone Controller] as DroneCtrl
    [AutoPilot (PID & Orbit)] as AutoPilot
    [Calibration Engine] as Calibration
}

package "Vision & AI Pipeline (Async Thread)" {
    [Vision Worker Thread] as VisionWorker
    [YOLO Object Detector] as YOLODetector
    [Position Estimator\n(Edge Math + Kalman)] as PoseEstimator
    [ArUco Calibrator\n(Oracle Fusion)] as Aruco
}

package "Active Learning & Data" {
    [Hybrid Sampler] as Sampler
    [Data Factory\n(RL Jittering)] as DataFactory
}

' --- Relationships ---

' Hardware Connections
DroneCtrl <..> Tello : UDP \n(Cmd: 8889, Vid: 11111)
JoystickHardware --> HeadlessPygame : USB / Bluetooth

' Input Flow
HeadlessPygame --> Joystick : Parses Axis/Buttons
KivyApp --> Joystick : Polls @ 60Hz via Clock

' Kivy UI Flow
KivyApp --> ControlCenterUI : Manages Overlays
KivyApp --> HUD : Updates Texture (30Hz)
KivyApp --> Room3DWidget : Feeds 3D Pose
KivyApp <--> DroneCtrl : Takeoff, Land, RC Commands

' Vision Pipeline Flow
DroneCtrl --> VisionWorker : Raw Video Stream
VisionWorker --> YOLODetector : Inference
VisionWorker --> Aruco : Detect Markers
VisionWorker --> PoseEstimator : Extract 3D Pose

' Video & Data Handoff
YOLODetector --> VisionWorker : Returns BBoxes
VisionWorker ..> HUD : Thread-Safe Frame Transfer\n(Pre-drawn BBoxes)
PoseEstimator ..> Room3DWidget : Thread-Safe Pose Transfer
PoseEstimator .up.> AutoPilot : Navigation Data

@enduml