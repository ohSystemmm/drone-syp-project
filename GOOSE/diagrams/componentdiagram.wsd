@startuml
!theme plain
skinparam componentStyle uml2
skinparam packageStyle rectangle
skinparam shadowing false
' Reduced spacing to prevent layout sprawl
skinparam ranksep 30
skinparam nodesep 20

title DJI Tello TT: Implementation Flow (Internal Logic)

' We wrap everything in a "System" package to keep the layout engine from exploding
package "Software System" {

    package "Core Logic" {
        component "DroneController" as DroneCtrl {
            port "UDP_Out" as DC_Cmd
            port "UDP_In" as DC_Vid
        }
        [AutoPilot] as Pilot
        [JoystickHandler] as JoyHandler
    }

    package "Vision Worker (Thread)" {
        [VisionWorker] as Worker
        [PositionEstimator] as PoseEst
        [ObjectDetector] as YOLO
        [ArucoCalibrator] as Aruco
    }

    package "Kivy / main.py" {
        [KivyApp] as App
        [Room3DView] as Room3D
        [HUD / Texture] as HUD
    }

    database "Filesystem" {
        [calibration.json] as Config
        [recordings/] as VideoDir
    }
}

' Internal Data Flow
App --> JoyHandler : calls get_rc_inputs()
App --> DC_Cmd : sends flight commands
DC_Vid --> Worker : raw frame array
Worker --> YOLO : detect(frame)
Worker --> Aruco : detect(frame)
YOLO --> PoseEst : ROI data
Aruco --> PoseEst : ArUco coords
PoseEst --> Worker : PoseEstimate object
Worker --> HUD : updates Texture
PoseEst --> Room3D : updates mesh
PoseEst --> Pilot : nav data
Pilot --> App : PID corrections
DroneCtrl --> VideoDir : saves .mp4
App --> Config : loads Z_SCALE
@enduml