#:kivy 2.0.0
#:import utils kivy.utils
#:set margin 10

#:include ui/kv/top_bar.kv
#:include ui/kv/stats.kv
#:include ui/kv/bottom_bar.kv
#:include ui/kv/flight_menu.kv
#:include ui/kv/shared.kv

FloatLayout:
    Video:
        id: videosstream
        source: 'ui/example-background/Video.mp4'
        state: 'play'
        options: {'eos': 'loop'}
        allow_stretch: True
        keep_ratio: False
        size_hint: 1, 1
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

    TopBar:
        id: header
        size_hint: 1, None
        height: 80
        pos_hint: {"top": 1}

    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: root.height - 180
        pos_hint: {"x": 0, "y": 0.12}
        spacing: 20
        padding: [20, 10, 20, 10]

        BoxLayout:
            orientation: 'vertical'
            size_hint: None, 1
            width: 300
            
            Widget:
            
            FlightMenu:
                id: flight_menu
            
            Widget:

        Widget:

        Stats:
            id: stats_area
            size_hint: None, 1
            width: 280

    BoxLayout:
        orientation: 'horizontal'
        size_hint: None, None
        size: 170, 26
        pos_hint: {"center_x": 0.5, "y": 0.13} 
        padding: [12, 0, 12, 0]
        spacing: 8
        canvas.before:
            Color:
                rgba: (25/255, 30/255, 25/255, 0.9)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [13]

        Widget:
            size_hint: None, None
            size: 10, 10
            pos_hint: {'center_y': 0.5}
            canvas.before:
                Color:
                    rgba: (0.85, 0.2, 0.2, 1)
                Ellipse:
                    pos: self.pos
                    size: self.size

        Label:
            text: f"RECORDING {app.recording_time}"
            font_size: '11sp'
            bold: True
            color: (0.95, 0.95, 0.95, 1)

    Bottom:
        id: footer
        size_hint: 0.4, 0.1
        pos_hint: {"center_x": 0.5, "y": 0.02}