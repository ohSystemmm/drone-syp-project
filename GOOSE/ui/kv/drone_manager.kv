#:kivy 2.0.0
#:import utils kivy.utils
#:import Icons ui.icons.Icons
#:set margin 10

# ── Individual drone card ────────────────────────────────────────
<DroneCard>:
    orientation: 'vertical'
    size_hint_y: None
    height: 110 if self.is_editing else 74
    padding: [16, 10, 16, 10]
    spacing: 6

    canvas.before:
        # Card background
        Color:
            rgba: (20/255, 60/255, 80/255, 0.55) if self.is_active else (30/255, 38/255, 46/255, 0.85)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
        # Active glow border
        Color:
            rgba: (0/255, 180/255, 255/255, 0.7) if self.is_active else (255/255, 255/255, 255/255, 0.06)
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
            width: 1.4

    # ── Normal display row ──
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 50
        spacing: 12
        opacity: 0 if root.is_editing else 1
        disabled: root.is_editing

        # Drone icon with coloured background
        Label:
            size_hint: None, None
            size: 40, 40
            pos_hint: {'center_y': 0.5}
            text: Icons.target
            font_name: 'Icons'
            font_size: '20sp'
            color: (0, 0.8, 1, 1) if root.is_active else (0.5, 0.6, 0.7, 1)
            canvas.before:
                Color:
                    rgba: (0, 0.7, 1, 0.18) if root.is_active else (1, 1, 1, 0.07)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [10]

        # Name + IP column
        BoxLayout:
            orientation: 'vertical'
            spacing: 2

            Label:
                text: root.drone_name or "Unnamed"
                font_size: '15sp'
                bold: True
                color: (1, 1, 1, 1)
                text_size: self.size
                halign: 'left'
                valign: 'bottom'

            BoxLayout:
                orientation: 'horizontal'
                spacing: 8
                size_hint_y: None
                height: 18

                Label:
                    text: root.drone_ip
                    font_size: '12sp'
                    color: (0.45, 0.55, 0.65, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'top'
                    size_hint_x: None
                    width: self.texture_size[0]

                Label:
                    text: "•"
                    font_size: '10sp'
                    color: (0.35, 0.45, 0.55, 1)
                    size_hint_x: None
                    width: 10

                Label:
                    text: root.last_used
                    font_size: '11sp'
                    color: (0.45, 0.55, 0.65, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'top'

        # Active badge
        Label:
            text: "ACTIVE" if root.is_active else ""
            font_size: '10sp'
            bold: True
            color: (0, 0.9, 0.5, 1)
            size_hint_x: None
            width: 50 if root.is_active else 0

        # Action buttons
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: 96
            spacing: 6
            pos_hint: {'center_y': 0.5}

            # Connect button
            Button:
                text: Icons.wifi
                font_name: 'Icons'
                font_size: '16sp'
                color: (0, 0.85, 1, 1) if self.state == 'normal' else (0, 0.6, 0.8, 1)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                size_hint: None, None
                size: 28, 28
                pos_hint: {'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: (0, 0.6, 1, 0.15) if self.state == 'normal' else (0, 0.6, 1, 0.3)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                on_release: app.drone_manager_panel.connect_drone(root.drone_ip)

            # Edit button
            Button:
                text: Icons.tune
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.7, 0.75, 0.8, 1)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                size_hint: None, None
                size: 28, 28
                pos_hint: {'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.06) if self.state == 'normal' else (1, 1, 1, 0.12)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                on_release: app.drone_manager_panel.start_edit(root.drone_ip, root.drone_name)

            # Delete button
            Button:
                text: Icons.delete
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.85, 0.35, 0.3, 1)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                size_hint: None, None
                size: 28, 28
                pos_hint: {'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: (0.85, 0.2, 0.2, 0.12) if self.state == 'normal' else (0.85, 0.2, 0.2, 0.25)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [8]
                on_release: app.drone_manager_panel.delete_drone(root.drone_ip)

    # ── Inline edit row (visible only when is_editing) ──
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 32 if root.is_editing else 0
        opacity: 1 if root.is_editing else 0
        disabled: not root.is_editing
        spacing: 8

        TextInput:
            id: edit_name_input
            text: app.drone_manager_panel.editing_name if app.drone_manager_panel else ""
            hint_text: "Name"
            multiline: False
            font_size: '13sp'
            foreground_color: (1, 1, 1, 1)
            background_color: (0.1, 0.12, 0.15, 1)
            cursor_color: (0, 0.7, 1, 1)
            padding: [10, 6, 10, 6]
            size_hint_x: 0.4
            on_text: app.drone_manager_panel.editing_name = self.text

        TextInput:
            id: edit_ip_input
            text: app.drone_manager_panel.editing_ip if app.drone_manager_panel else ""
            hint_text: "IP Address"
            multiline: False
            font_size: '13sp'
            foreground_color: (1, 1, 1, 1)
            background_color: (0.1, 0.12, 0.15, 1)
            cursor_color: (0, 0.7, 1, 1)
            padding: [10, 6, 10, 6]
            size_hint_x: 0.4
            on_text: app.drone_manager_panel.editing_ip = self.text

        Button:
            text: Icons.content_save
            font_name: 'Icons'
            font_size: '16sp'
            color: (0, 0.9, 0.5, 1)
            background_normal: ''
            background_color: (0, 0, 0, 0)
            size_hint_x: None
            width: 32
            canvas.before:
                Color:
                    rgba: (0, 0.7, 0.3, 0.2)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [6]
            on_release: app.drone_manager_panel.save_edit()

        Button:
            text: Icons.close
            font_name: 'Icons'
            font_size: '16sp'
            color: (0.8, 0.4, 0.4, 1)
            background_normal: ''
            background_color: (0, 0, 0, 0)
            size_hint_x: None
            width: 32
            canvas.before:
                Color:
                    rgba: (0.7, 0.2, 0.2, 0.2)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [6]
            on_release: app.drone_manager_panel.cancel_edit()


# ── Full-screen drone manager overlay ────────────────────────────
<DroneManager>:
    size_hint: 1, 1
    pos_hint: {"x": 0, "y": 0}

    # Dimmed backdrop
    canvas.before:
        Color:
            rgba: (0, 0, 0, 0.65)
        Rectangle:
            pos: self.pos
            size: self.size

    # ── Main card panel ──
    BoxLayout:
        orientation: 'vertical'
        size_hint: 0.55, 0.82
        pos_hint: {"center_x": 0.5, "center_y": 0.5}
        padding: [0, 0, 0, 0]
        spacing: 0

        canvas.before:
            # Panel background with glass blur feel
            Color:
                rgba: (18/255, 24/255, 32/255, 0.97)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
            # Subtle top accent line
            Color:
                rgba: (0/255, 160/255, 230/255, 0.35)
            Line:
                points: [self.x + 20, self.top, self.right - 20, self.top]
                width: 1.4

        # ── Header ──
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 68
            padding: [28, 14, 20, 10]
            spacing: 14

            # Drone icon
            Label:
                text: Icons.target
                font_name: 'Icons'
                font_size: '24sp'
                color: (0, 0.75, 1, 1)
                size_hint_x: None
                width: 30

            # Title + subtitle
            BoxLayout:
                orientation: 'vertical'
                spacing: 0

                Label:
                    text: "Drone Fleet"
                    font_size: '20sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'

                Label:
                    text: "Add, edit & connect your drones"
                    font_size: '12sp'
                    color: (0.45, 0.55, 0.65, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'top'

            Widget:

            # Close button
            Button:
                text: Icons.close
                font_name: 'Icons'
                font_size: '20sp'
                color: (0.6, 0.65, 0.7, 1)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                size_hint: None, None
                size: 36, 36
                pos_hint: {'center_y': 0.5}
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.06)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]
                on_release: root.close()

        # ── Divider ──
        Widget:
            size_hint_y: None
            height: 1
            canvas:
                Color:
                    rgba: (1, 1, 1, 0.07)
                Rectangle:
                    pos: self.x + 24, self.y
                    size: self.width - 48, 1

        # ── Add new drone section ──
        BoxLayout:
            orientation: 'vertical'
            size_hint_y: None
            height: 100
            padding: [28, 16, 28, 8]
            spacing: 10

            Label:
                text: "ADD NEW DRONE"
                font_size: '11sp'
                bold: True
                color: (0.45, 0.55, 0.65, 1)
                size_hint_y: None
                height: 16
                text_size: self.size
                halign: 'left'
                valign: 'middle'

            BoxLayout:
                orientation: 'horizontal'
                spacing: 10
                size_hint_y: None
                height: 42

                # IP input
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_x: 0.45
                    padding: [0, 0, 0, 0]
                    canvas.before:
                        Color:
                            rgba: (25/255, 32/255, 42/255, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                        Color:
                            rgba: (1, 1, 1, 0.08)
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
                            width: 1

                    TextInput:
                        id: input_ip
                        text: root.new_drone_ip
                        hint_text: "192.168.10.1"
                        hint_text_color: (0.35, 0.4, 0.5, 0.6)
                        multiline: False
                        font_size: '14sp'
                        foreground_color: (1, 1, 1, 1)
                        background_color: (0, 0, 0, 0)
                        cursor_color: (0, 0.7, 1, 1)
                        padding: [14, 10, 14, 10]
                        on_text: root.new_drone_ip = self.text

                # Name input
                BoxLayout:
                    orientation: 'horizontal'
                    size_hint_x: 0.35
                    canvas.before:
                        Color:
                            rgba: (25/255, 32/255, 42/255, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                        Color:
                            rgba: (1, 1, 1, 0.08)
                        Line:
                            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
                            width: 1

                    TextInput:
                        id: input_name
                        text: root.new_drone_name
                        hint_text: "Nickname (optional)"
                        hint_text_color: (0.35, 0.4, 0.5, 0.6)
                        multiline: False
                        font_size: '14sp'
                        foreground_color: (1, 1, 1, 1)
                        background_color: (0, 0, 0, 0)
                        cursor_color: (0, 0.7, 1, 1)
                        padding: [14, 10, 14, 10]
                        on_text: root.new_drone_name = self.text

                # Add button
                Button:
                    text: "Add"
                    bold: True
                    font_size: '14sp'
                    color: (1, 1, 1, 1)
                    background_normal: ''
                    background_color: (0, 0, 0, 0)
                    size_hint_x: 0.2
                    canvas.before:
                        Color:
                            rgba: (0/255, 140/255, 210/255, 1) if self.state == 'normal' else (0/255, 110/255, 180/255, 1)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [10]
                    on_release: root.add_drone()

        # ── Divider ──
        Widget:
            size_hint_y: None
            height: 1
            canvas:
                Color:
                    rgba: (1, 1, 1, 0.07)
                Rectangle:
                    pos: self.x + 24, self.y
                    size: self.width - 48, 1

        # ── Registered drones header ──
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 36
            padding: [28, 10, 28, 0]

            Label:
                text: "REGISTERED DRONES"
                font_size: '11sp'
                bold: True
                color: (0.45, 0.55, 0.65, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'

            Widget:

            Button:
                text: Icons.refresh
                font_name: 'Icons'
                font_size: '18sp'
                color: (0.5, 0.6, 0.7, 1)
                background_normal: ''
                background_color: (0, 0, 0, 0)
                size_hint_x: None
                width: 30
                on_release: root.refresh_drone_list()

        # ── Scrollable drone list ──
        ScrollView:
            size_hint: 1, 1
            bar_width: 4
            bar_color: (0, 0.6, 1, 0.4)
            bar_inactive_color: (0.3, 0.35, 0.4, 0.2)
            do_scroll_x: False

            BoxLayout:
                id: drone_grid
                orientation: 'vertical'
                size_hint_y: None
                height: self.minimum_height
                padding: [28, 10, 28, 20]
                spacing: 10

        # ── Footer / tip ──
        BoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: 40
            padding: [28, 6, 28, 12]

            Label:
                text: "[font=Icons]" + Icons.wifi + "[/font]  Tap the connect icon to switch drones"
                markup: True
                font_size: '11sp'
                color: (0.38, 0.45, 0.55, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'
