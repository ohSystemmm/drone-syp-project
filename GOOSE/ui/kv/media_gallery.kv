#:kivy 2.0.0
#:import utils kivy.utils
#:import Icons ui.icons.Icons
#:import os os
#:import LEDDrawingGrid ui.media_gallery.LEDDrawingGrid
#:import PresetCard ui.media_gallery.PresetCard
#:import HoverButton ui.media_gallery.HoverButton
#:import ClickableLabel ui.media_gallery.ClickableLabel
#:import ClickableBox ui.media_gallery.ClickableBox
#:set margin 10

<ClickableLabel>:
    opacity: 1.0 if not self.hovered else 0.8

<ClickableBox>:
    opacity: 1.0 if not self.hovered else 0.85

<HoverButton>:
    opacity: 1.0 if not self.hovered else 0.85

<PresetCard>:
    
    orientation: 'horizontal'
    padding: [10, 8, 10, 8]
    spacing: 8
    size_hint_y: None
    height: 46
    canvas.before:
        Color:
            rgba: (25/255, 35/255, 58/255, 0.9) if (self.hovered and self.state == 'normal') else ((18/255, 25/255, 41/255, 0.85) if self.state == 'normal' else (28/255, 39/255, 64/255, 0.95))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]
        Color:
            rgba: self.color_theme if self.state == 'down' else (self.color_theme[0], self.color_theme[1], self.color_theme[2], 0.15)
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 8]
            width: 1.5 if self.state == 'down' else 1
    on_release:
        app.on_action("LED_PATTERN", root.text.lower())
        if root.grid_id: root.grid_id.load_pattern_string(root.pattern_string)
            
    Label:
        text: root.icon
        font_name: 'Icons'
        font_size: '16sp'
        color: root.color_theme
        size_hint_x: None
        width: 20
        
    BoxLayout:
        orientation: 'vertical'
        spacing: 1
        Label:
            text: root.text
            font_size: '11sp'
            bold: True
            color: (1, 1, 1, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
        Label:
            text: "Apply Preset"
            font_size: '8sp'
            color: (0.45, 0.5, 0.6, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'

<VerticalDivider@Widget>:
    size_hint_x: None
    width: 1
    canvas:
        Color:
            rgba: (1, 1, 1, 0.1)
        Rectangle:
            pos: self.pos
            size: self.size

<SettingGroup@BoxLayout>:
    orientation: 'vertical'
    size_hint_y: None
    height: self.minimum_height
    spacing: 10
    title: ""
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.02)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
    
    Label:
        text: root.title
        font_size: '10sp'
        bold: True
        color: (0.4, 0.5, 0.6, 1)
        size_hint_y: None
        height: 24
        text_size: self.size
        halign: 'left'
        padding: [15, 0, 0, 0]

<CustomSettingItem@ButtonBehavior+BoxLayout>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 50
    padding: [15, 0, 15, 0]
    spacing: 15
    icon: ""
    text: ""
    value: ""
    
    canvas.before:
        Color:
            rgba: (1, 1, 1, 0.05) if self.state == 'down' else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

    Label:
        text: root.icon
        font_name: 'Icons'
        font_size: '18sp'
        color: (0.3, 0.7, 1, 1)
        size_hint_x: None
        width: 30

    Label:
        text: root.text
        font_size: '14sp'
        color: (0.9, 0.95, 1, 1)
        text_size: self.size
        halign: 'left'
        valign: 'middle'

    Label:
        text: root.value
        font_size: '13sp'
        color: (0.5, 0.6, 0.7, 1)
        text_size: self.size
        halign: 'right'
        valign: 'middle'

<IconButton@ButtonBehavior+BoxLayout>:
    # Base class for buttons that look like boxes
    spacing: 8

# ─── Media Card ──────────────────────────────────────────
<MediaCard>:
    orientation: 'vertical'
    size_hint: None, None
    size: 200, 220
    spacing: 6

    # Thumbnail area
    BoxLayout:
        size_hint_y: None
        height: 140
        canvas.before:
            Color:
                rgba: root.thumb_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [10, 10, 4, 4]
            # Selection highlight border
            Color:
                rgba: (0, 0.6, 1, 0.8) if root.is_selected else (0.2, 0.25, 0.35, 0.6)
            Line:
                rounded_rectangle: [self.x, self.y, self.width, self.height, 10, 10, 4, 4]
                width: 1.5 if root.is_selected else 1

        # Center icon (camera or play button)
        Label:
            text: Icons.play_circle if root.is_video else Icons.camera
            font_name: 'Icons'
            font_size: '36sp' if root.is_video else '28sp'
            color: (1, 1, 1, 0.5) if not root.is_video else (1, 1, 1, 0.7)

    # Filename + size row
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 18
        padding: [4, 0, 4, 0]

        Label:
            text: root.filename[:22] + "..." if len(root.filename) > 25 else root.filename
            font_size: '11sp'
            bold: True
            color: (0.85, 0.9, 0.95, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            shorten: True

        Label:
            text: root.file_size
            font_size: '10sp'
            color: (0.5, 0.6, 0.7, 1)
            size_hint_x: None
            width: 60
            text_size: self.size
            halign: 'right'
            valign: 'middle'

    # Date row
    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: None
        height: 16
        padding: [4, 0, 4, 0]
        spacing: 4

        Label:
            text: Icons.calendar if root.file_date else ""
            font_name: 'Icons'
            font_size: '11sp'
            color: (0.4, 0.5, 0.6, 1)
            size_hint_x: None
            width: 14

        Label:
            text: root.file_date
            font_size: '10sp'
            color: (0.4, 0.5, 0.6, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'


# ─── Nav Item ────────────────────────────────────────────
<NavItem>:
    orientation: 'horizontal'
    size_hint_y: None
    height: 40
    padding: [14, 0, 14, 0]
    spacing: 12

    canvas.before:
        Color:
            rgba: (0, 0.45, 0.75, 0.35) if self.is_active else ((0.1, 0.16, 0.28, 0.4) if self.hovered else ((1, 1, 1, 0.05) if self.state == 'down' else (0, 0, 0, 0)))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]

    Label:
        text: root.icon
        font_name: 'Icons'
        font_size: '17sp'
        color: (0.3, 0.7, 1, 1) if root.is_active else (0.5, 0.6, 0.7, 1)
        size_hint_x: None
        width: 24

    Label:
        text: root.text
        font_size: '13sp'
        bold: root.is_active
        color: (1, 1, 1, 1) if root.is_active else (0.7, 0.75, 0.8, 1)
        text_size: self.size
        halign: 'left'
        valign: 'middle'


# ─── Filter Chip ─────────────────────────────────────────
<FilterChip>:
    orientation: 'horizontal'
    size_hint: None, None
    height: 34
    width: 110 if self.has_dropdown else 90
    padding: [14, 0, 14, 0]
    spacing: 6

    canvas.before:
        Color:
            rgba: (0, 0.5, 0.8, 0.5) if self.is_active else (0.15, 0.18, 0.25, 0.8)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [17]
        Color:
            rgba: (0, 0.55, 0.9, 0.7) if self.is_active else (0.25, 0.3, 0.4, 0.6)
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 17]
            width: 1

    Label:
        text: root.text
        font_size: '12sp'
        bold: root.is_active
        color: (1, 1, 1, 1) if root.is_active else (0.7, 0.75, 0.85, 1)

    Label:
        text: Icons.chevron_down if root.has_dropdown else ""
        font_name: 'Icons'
        font_size: '14sp'
        color: (0.6, 0.7, 0.8, 1)
        size_hint_x: None
        width: 16 if root.has_dropdown else 0


# ─── Media Gallery (Full Overlay) ────────────────────────
<MediaGallery>:

    canvas.before:
        Color:
            rgba: (12/255, 17/255, 29/255, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    # ===== TOP NAV BAR =====
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, None
        height: 56
        pos_hint: {"top": 1}
        padding: [20, 8, 20, 8]
        spacing: 14

        canvas.before:
            Color:
                rgba: (16/255, 22/255, 36/255, 1)
            Rectangle:
                pos: self.pos
                size: self.size
            Color:
                rgba: (0.15, 0.2, 0.3, 0.5)
            Rectangle:
                pos: self.x, self.y
                size: self.width, 1

        # App Logo + Title
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: 200
            spacing: 10

            Label:
                text: Icons.sync
                font_name: 'Icons'
                font_size: '22sp'
                color: (0.2, 0.7, 1, 1)
                size_hint_x: None
                width: 30

            Label:
                text: "GOOSE Control"
                font_size: '15sp'
                bold: True
                color: (1, 1, 1, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # Nav Links
        ClickableLabel:
            text: "Dashboard"
            font_size: '13sp'
            color: (0.5, 0.55, 0.65, 1)
            size_hint_x: None
            width: 80
            on_release: app.close_media_gallery()

        Label:
            text: "Media Gallery"
            font_size: '13sp'
            bold: True
            color: (0.2, 0.65, 1, 1)
            size_hint_x: None
            width: 100

        ClickableLabel:
            text: "Flight Logs"
            font_size: '13sp'
            color: (0.5, 0.55, 0.65, 1)
            size_hint_x: None
            width: 80
            on_release: root.set_active_nav("Flight Logs")

        ClickableLabel:
            text: "Settings"
            font_size: '13sp'
            color: (0.5, 0.55, 0.65, 1)
            size_hint_x: None
            width: 60
            on_release: root.set_active_nav("Settings")

        Widget:

        # Search Bar
        BoxLayout:
            size_hint_x: None
            width: 220
            padding: [12, 6, 12, 6]
            canvas.before:
                Color:
                    rgba: (0.08, 0.1, 0.16, 0.8)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]
                Color:
                    rgba: (0.2, 0.25, 0.35, 0.5)
                Line:
                    rounded_rectangle: [self.x, self.y, self.width, self.height, 18]
                    width: 1

            Label:
                text: Icons.magnify
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.4, 0.5, 0.6, 1)
                size_hint_x: None
                width: 22

            Label:
                text: "Search gallery..."
                font_size: '12sp'
                color: (0.35, 0.4, 0.5, 1)
                text_size: self.size
                halign: 'left'
                valign: 'middle'

        # Sync Button
        ClickableBox:
            size_hint_x: None
            width: 160
            padding: [14, 6, 14, 6]
            spacing: 8
            on_release: root.sync_from_drone()
            canvas.before:
                Color:
                    rgba: (0, 0.45, 0.75, 1)
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]

            Label:
                text: Icons.refresh
                font_name: 'Icons'
                font_size: '15sp'
                color: (1, 1, 1, 1)
                size_hint_x: None
                width: 20

            Label:
                text: "Sync from Drone"
                font_size: '12sp'
                bold: True
                color: (1, 1, 1, 1)



    # ===== MAIN BODY (Sidebar + Content) =====
    BoxLayout:
        orientation: 'horizontal'
        size_hint: 1, 1
        pos_hint: {"x": 0, "y": 0}
        padding: [0, 56, 0, 0]

        # ─── LEFT SIDEBAR ─────────────────────
        BoxLayout:
            orientation: 'vertical'
            size_hint_x: None
            width: 200
            padding: [12, 16, 12, 16]
            spacing: 6

            canvas.before:
                Color:
                    rgba: (14/255, 19/255, 32/255, 1)
                Rectangle:
                    pos: self.pos
                    size: self.size
                Color:
                    rgba: (0.12, 0.16, 0.25, 0.6)
                Rectangle:
                    pos: self.x + self.width - 1, self.y
                    size: 1, self.height

            # Drone Status Pill
            BoxLayout:
                orientation: 'horizontal'
                size_hint_y: None
                height: 50
                padding: [10, 6, 10, 6]
                spacing: 10
                canvas.before:
                    Color:
                        rgba: (0.06, 0.1, 0.16, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

                Label:
                    text: Icons.sync
                    font_name: 'Icons'
                    font_size: '20sp'
                    color: (0.2, 0.65, 1, 1)
                    size_hint_x: None
                    width: 28

                BoxLayout:
                    orientation: 'vertical'
                    spacing: 1

                    Label:
                        text: "GOOSE-01"
                        font_size: '12sp'
                        bold: True
                        color: (1, 1, 1, 1)
                        text_size: self.size
                        halign: 'left'
                        valign: 'bottom'

                    BoxLayout:
                        orientation: 'horizontal'
                        size_hint_y: None
                        height: 14
                        spacing: 4

                        Widget:
                            size_hint: None, None
                            size: 7, 7
                            pos_hint: {'center_y': 0.5}
                            canvas.before:
                                Color:
                                    rgba: (0.2, 0.8, 0.4, 1)
                                Ellipse:
                                    pos: self.pos
                                    size: self.size

                        Label:
                            text: "CONNECTED"
                            font_size: '9sp'
                            color: (0.2, 0.8, 0.4, 1)
                            text_size: self.size
                            halign: 'left'
                            valign: 'middle'

            Widget:
                size_hint_y: None
                height: 14

            # NAVIGATION section header
            Label:
                text: "NAVIGATION"
                font_size: '10sp'
                bold: True
                color: (0.35, 0.4, 0.5, 1)
                size_hint_y: None
                height: 22
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                padding: [14, 0, 0, 0]

            NavItem:
                icon: Icons.view_grid
                text: "All Media"
                is_active: root.active_nav == "All Media"
                on_release: root.set_active_nav("All Media")

            NavItem:
                icon: Icons.image
                text: "Photos"
                is_active: root.active_nav == "Photos"
                on_release: root.set_active_nav("Photos")

            NavItem:
                icon: Icons.video_outline
                text: "Videos"
                is_active: root.active_nav == "Videos"
                on_release: root.set_active_nav("Videos")

            NavItem:
                icon: Icons.star
                text: "Favorites"
                is_active: root.active_nav == "Favorites"
                on_release: root.set_active_nav("Favorites")

            NavItem:
                icon: Icons.quadcopter
                text: "Drone Fleet"
                is_active: root.active_nav == "Drone Fleet"
                on_release: root.set_active_nav("Drone Fleet")

            NavItem:
                icon: Icons.cog
                text: "General Settings"
                is_active: root.active_nav == "Settings"
                on_release: root.set_active_nav("Settings")

            NavItem:
                icon: Icons.led
                text: "Drone LED"
                is_active: root.active_nav == "Drone LED"
                on_release: root.set_active_nav("Drone LED")

            Widget:
                size_hint_y: None
                height: 20


            # STORAGE section
            Label:
                text: "STORAGE"
                font_size: '10sp'
                bold: True
                color: (0.35, 0.4, 0.5, 1)
                size_hint_y: None
                height: 22
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                padding: [14, 0, 0, 0]

            # Storage progress bar
            Widget:
                size_hint_y: None
                height: 6
                canvas:
                    Color:
                        rgba: (0.15, 0.2, 0.3, 1)
                    RoundedRectangle:
                        pos: self.x + 14, self.y
                        size: self.width - 28, self.height
                        radius: [3]
                    Color:
                        rgba: (0.1, 0.5, 0.9, 1)
                    RoundedRectangle:
                        pos: self.x + 14, self.y
                        size: (self.width - 28) * root.storage_percent, self.height
                        radius: [3]

            Label:
                text: root.storage_used + " of " + root.storage_total + " used"
                font_size: '10sp'
                color: (0.4, 0.5, 0.6, 1)
                size_hint_y: None
                height: 18
                text_size: self.size
                halign: 'left'
                valign: 'middle'
                padding: [14, 0, 0, 0]

            Widget:

            # Cloud Backup button
            ClickableBox:
                on_release: root.cloud_backup()
                orientation: 'horizontal'
                size_hint_y: None
                height: 42
                padding: [12, 6, 12, 6]
                spacing: 8
                canvas.before:
                    Color:
                        rgba: (0.06, 0.1, 0.16, 1)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [10]

                Label:
                    text: Icons.cloud_upload
                    font_name: 'Icons'
                    font_size: '16sp'
                    color: (0.4, 0.55, 0.7, 1)
                    size_hint_x: None
                    width: 22

                Label:
                    text: "Cloud Backup"
                    font_size: '12sp'
                    color: (0.7, 0.75, 0.8, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'middle'

        # ─── MAIN CONTENT AREA ────────────────
        RelativeLayout:
            ScreenManager:
                id: content_manager
                # current set in Python on_active_nav

                Screen:
                    name: "Media"
                    BoxLayout:
                        orientation: 'vertical'
                        padding: [28, 20, 28, 70]
                        spacing: 16

                        # Title Row
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: 60

                            BoxLayout:
                                orientation: 'vertical'
                                spacing: 4

                                Label:
                                    text: "Media Gallery"
                                    font_size: '26sp'
                                    bold: True
                                    color: (1, 1, 1, 1)
                                    text_size: self.size
                                    halign: 'left'
                                    valign: 'bottom'

                                Label:
                                    text: "Manage your aerial captures and drone telemetry media."
                                    font_size: '12sp'
                                    color: (0.45, 0.5, 0.6, 1)
                                    text_size: self.size
                                    halign: 'left'
                                    valign: 'top'

                            Widget:

                            # Selection Mode + View toggle
                            BoxLayout:
                                orientation: 'horizontal'
                                size_hint: None, None
                                size: 220, 36
                                pos_hint: {"center_y": 0.5}
                                spacing: 10

                                ClickableBox:
                                    size_hint_x: None
                                    width: 148
                                    padding: [12, 4, 12, 4]
                                    spacing: 6
                                    on_release: root.toggle_selection_mode()
                                    canvas.before:
                                        Color:
                                            rgba: (0.08, 0.12, 0.2, 0.9) if not root.selection_mode else (0, 0.45, 0.75, 0.9)
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [18]

                                    Label:
                                        text: Icons.filter_variant
                                        font_name: 'Icons'
                                        font_size: '14sp'
                                        color: (0.4, 0.6, 0.85, 1) if not root.selection_mode else (1, 1, 1, 1)
                                        size_hint_x: None
                                        width: 18

                                    Label:
                                        text: "Selection Mode"
                                        font_size: '11sp'
                                        color: (0.7, 0.8, 0.9, 1) if not root.selection_mode else (1, 1, 1, 1)

                                BoxLayout:
                                    size_hint_x: None
                                    width: 56
                                    padding: [4, 4, 4, 4]
                                    spacing: 2
                                    canvas.before:
                                        Color:
                                            rgba: (0.08, 0.12, 0.2, 0.9)
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [8]

                                    Label:
                                        text: Icons.view_grid
                                        font_name: 'Icons'
                                        font_size: '16sp'
                                        color: (0.3, 0.65, 1, 1)

                                    Label:
                                        text: Icons.view_list
                                        font_name: 'Icons'
                                        font_size: '16sp'
                                        color: (0.4, 0.5, 0.6, 1)

                        # Filter Chips Row
                        BoxLayout:
                            orientation: 'horizontal'
                            size_hint_y: None
                            height: 38
                            spacing: 10

                            FilterChip:
                                text: "All Items"
                                is_active: root.active_nav == "All Media"
                                on_release: root.set_active_nav("All Media")

                            FilterChip:
                                text: "Photos"
                                is_active: root.active_nav == "Photos"
                                on_release: root.set_active_nav("Photos")

                            FilterChip:
                                text: "Videos"
                                is_active: root.active_nav == "Videos"
                                on_release: root.set_active_nav("Videos")

                            FilterChip:
                                text: "Favorites"
                                is_active: root.active_nav == "Favorites"
                                on_release: root.set_active_nav("Favorites")

                            Widget:

                        # ─── Scrollable Media Grid ───
                        ScrollView:
                            do_scroll_x: False
                            bar_width: 6
                            bar_color: (0.2, 0.4, 0.6, 0.5)
                            bar_inactive_color: (0.15, 0.2, 0.3, 0.3)

                            GridLayout:
                                id: media_grid
                                cols: 4
                                spacing: 16
                                padding: [0, 8, 0, 8]
                                size_hint_y: None
                                height: self.minimum_height
                                col_default_width: 200
                                row_default_height: 220

                        # Load More + Counter
                        BoxLayout:
                            orientation: 'vertical'
                            size_hint_y: None
                            height: 70
                            spacing: 8

                            BoxLayout:
                                size_hint: None, None
                                size: 200, 36
                                pos_hint: {"center_x": 0.5}
                                canvas.before:
                                    Color:
                                        rgba: (0.1, 0.14, 0.22, 1)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [18]
                                    Color:
                                        rgba: (0.2, 0.28, 0.4, 0.6)
                                    Line:
                                        rounded_rectangle: [self.x, self.y, self.width, self.height, 18]
                                        width: 1

                                Label:
                                    text: "Load More Captures"
                                    font_size: '12sp'
                                    bold: True
                                    color: (0.75, 0.8, 0.9, 1)

                            Label:
                                text: "SHOWING " + str(root.shown_items) + " OF " + str(root.total_items) + " ITEMS"
                                font_size: '10sp'
                                color: (0.35, 0.4, 0.5, 1)
                                size_hint_y: None
                                height: 20

                Screen:
                    name: "Settings"
                    BoxLayout:
                        orientation: 'vertical'
                        padding: [40, 20, 40, 70]
                        spacing: 24
                        
                        Label:
                            text: "General Settings"
                            font_size: '26sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            size_hint_y: None
                            height: 40
                            text_size: self.size
                            halign: 'left'
                        
                        ScrollView:
                            do_scroll_x: False
                            BoxLayout:
                                orientation: 'vertical'
                                size_hint_y: None
                                height: self.minimum_height
                                spacing: 20
                                
                                # Connection Group
                                SettingGroup:
                                    title: "CONNECTION"
                                    
                                    CustomSettingItem:
                                        icon: Icons.wifi
                                        text: "Drone IP Address"
                                        value: app.drone_ip
                                        on_release: app.on_action("EDIT_IP")
                                    
                                    CustomSettingItem:
                                        icon: Icons.sync
                                        text: "UDP Port"
                                        value: str(app.args.port if app.args else 8889)
                                
                                # Vision Group
                                SettingGroup:
                                    title: "AI VISION"
                                    
                                    CustomSettingItem:
                                        icon: Icons.eye
                                        text: "Toggle Vision System"
                                        value: "PAUSED" if app.vision_thread and getattr(app.vision_thread, 'is_paused', False) else "ACTIVE"
                                        on_release: app.on_action("TOGGLE_VISION")
                                        
                                    CustomSettingItem:
                                        icon: Icons.target
                                        text: "Confidence Threshold"
                                        value: f"{app.conf_threshold:.2f}"
                                        on_release: app.on_action("CYCLE_CONF")
                                    
                                    CustomSettingItem:
                                        icon: Icons.file_document
                                        text: "Model Type"
                                        value: app.model_type
                                        on_release: app.on_action("CYCLE_MODEL")
                                
                                # Flight Group
                                SettingGroup:
                                    title: "FLIGHT & CALIBRATION"
                                    
                                    CustomSettingItem:
                                        icon: Icons.camera
                                        text: "Downward Camera"
                                        value: app.downward_cam_status
                                        on_release: app.on_action("TOGGLE_DOWNWARD_CAM")
                Screen:
                    name: "LED"
                    BoxLayout:
                        orientation: 'vertical'
                        padding: [30, 15, 30, 20]
                        spacing: 16
                        
                        Label:
                            text: "Drone LED Matrix Control"
                            font_size: '22sp'
                            bold: True
                            color: (1, 1, 1, 1)
                            size_hint_y: None
                            height: 32
                            text_size: self.size
                            halign: 'left'
                        
                        BoxLayout:
                            orientation: 'horizontal'
                            spacing: 24
                            
                            # Left side: Drawing Grid & Tools
                            BoxLayout:
                                orientation: 'vertical'
                                spacing: 12
                                size_hint_x: 0.45
                                padding: [16, 16, 16, 16]
                                canvas.before:
                                    Color:
                                        rgba: (20/255, 27/255, 45/255, 0.7)
                                    RoundedRectangle:
                                        pos: self.pos
                                        size: self.size
                                        radius: [12]
                                    Color:
                                        rgba: (0.15, 0.22, 0.35, 0.3)
                                    Line:
                                        rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
                                        width: 1
                                
                                Label:
                                    text: "DRAWING CANVAS"
                                    font_size: '10sp'
                                    bold: True
                                    color: (0.2, 0.65, 1, 1)
                                    size_hint_y: None
                                    height: 14
                                    text_size: self.size
                                    halign: 'left'

                                # Centered canvas container
                                AnchorLayout:
                                    anchor_x: 'center'
                                    anchor_y: 'center'
                                    
                                    LEDDrawingGrid:
                                        id: led_grid
                                        size_hint: None, None
                                        size: 200, 200

                                # Color Palette Row
                                BoxLayout:
                                    orientation: 'horizontal'
                                    size_hint_y: None
                                    height: 38
                                    spacing: 14
                                    padding: [10, 0, 10, 0]
                                    
                                    # Off / Eraser (Dark outline brush)
                                    HoverButton:
                                        size_hint: None, None
                                        size: 30, 30
                                        background_normal: ''
                                        background_color: (30/255, 38/255, 58/255, 1)
                                        canvas.after:
                                            Color:
                                                rgba: (1, 1, 1, 1) if led_grid.active_color == '0' else (1, 1, 1, 0.1)
                                            Line:
                                                circle: (self.center_x, self.center_y, 14)
                                                width: 2 if led_grid.active_color == '0' else 1
                                        text: Icons.eraser
                                        font_name: 'Icons'
                                        font_size: '12sp'
                                        color: (0.6, 0.7, 0.8, 1)
                                        on_release: led_grid.active_color = '0'
                                        
                                    # Red Brush
                                    HoverButton:
                                        size_hint: None, None
                                        size: 30, 30
                                        background_normal: ''
                                        background_color: (255/255, 60/255, 80/255, 1)
                                        canvas.after:
                                            Color:
                                                rgba: (1, 1, 1, 1) if led_grid.active_color == 'r' else (1, 1, 1, 0.1)
                                            Line:
                                                circle: (self.center_x, self.center_y, 14)
                                                width: 2 if led_grid.active_color == 'r' else 1
                                        on_release: led_grid.active_color = 'r'
                                        
                                    # Blue Brush
                                    HoverButton:
                                        size_hint: None, None
                                        size: 30, 30
                                        background_normal: ''
                                        background_color: (0/255, 160/255, 255/255, 1)
                                        canvas.after:
                                            Color:
                                                rgba: (1, 1, 1, 1) if led_grid.active_color == 'b' else (1, 1, 1, 0.1)
                                            Line:
                                                circle: (self.center_x, self.center_y, 14)
                                                width: 2 if led_grid.active_color == 'b' else 1
                                        on_release: led_grid.active_color = 'b'
                                        
                                    # Purple Brush
                                    HoverButton:
                                        size_hint: None, None
                                        size: 30, 30
                                        background_normal: ''
                                        background_color: (180/255, 70/255, 255/255, 1)
                                        canvas.after:
                                            Color:
                                                rgba: (1, 1, 1, 1) if led_grid.active_color == 'p' else (1, 1, 1, 0.1)
                                            Line:
                                                circle: (self.center_x, self.center_y, 14)
                                                width: 2 if led_grid.active_color == 'p' else 1
                                        on_release: led_grid.active_color = 'p'
                                
                                BoxLayout:
                                    orientation: 'horizontal'
                                    size_hint_y: None
                                    height: 36
                                    spacing: 12
                                    
                                    HoverButton:
                                        text: "CLEAR"
                                        background_normal: ''
                                        background_color: (40/255, 20/255, 30/255, 1)
                                        color: (0.9, 0.4, 0.4, 1)
                                        on_release: led_grid.clear_grid()
                                    HoverButton:
                                        text: "SEND TO DRONE"
                                        background_normal: ''
                                        background_color: (0.1, 0.6, 0.35, 1)
                                        bold: True
                                        color: (1, 1, 1, 1)
                                        on_release: app.on_action("LED_PATTERN_CUSTOM", led_grid.get_pattern_string())

                            # Right side: Presets & Scrolling Text
                            BoxLayout:
                                orientation: 'vertical'
                                spacing: 14
                                size_hint_x: 0.55
                                
                                # Text Scrolling Section
                                BoxLayout:
                                    orientation: 'vertical'
                                    size_hint_y: None
                                    height: 154
                                    spacing: 8
                                    padding: [16, 12, 16, 12]
                                    canvas.before:
                                        Color:
                                            rgba: (20/255, 27/255, 45/255, 0.7)
                                        RoundedRectangle:
                                            pos: self.pos
                                            size: self.size
                                            radius: [12]
                                        Color:
                                            rgba: (0.15, 0.22, 0.35, 0.3)
                                        Line:
                                            rounded_rectangle: [self.x, self.y, self.width, self.height, 12]
                                            width: 1

                                    Label:
                                        text: "SCROLLING TEXT CONTROLLER"
                                        font_size: '10sp'
                                        bold: True
                                        color: (0.2, 0.65, 1, 1)
                                        size_hint_y: None
                                        height: 14
                                        text_size: self.size
                                        halign: 'left'

                                    BoxLayout:
                                        orientation: 'horizontal'
                                        spacing: 10
                                        size_hint_y: None
                                        height: 36
                                        
                                        TextInput:
                                            id: led_text_input
                                            hint_text: "Type custom message..."
                                            multiline: False
                                            padding: [10, 8]
                                            background_normal: ''
                                            background_color: (10/255, 15/255, 25/255, 1)
                                            foreground_color: (1, 1, 1, 1)
                                            font_size: '12sp'
                                        
                                        HoverButton:
                                            text: "SEND"
                                            size_hint_x: None
                                            width: 70
                                            background_normal: ''
                                            background_color: (0, 0.45, 0.8, 1)
                                            bold: True
                                            on_release: app.on_action("LED_TEXT", led_text_input.text, root.scroll_color, root.scroll_dir)

                                    # Color & Direction selections
                                    BoxLayout:
                                        orientation: 'horizontal'
                                        spacing: 12
                                        
                                        # Color Selector Column
                                        BoxLayout:
                                            orientation: 'vertical'
                                            spacing: 4
                                            Label:
                                                text: "TEXT COLOR"
                                                font_size: '8sp'
                                                color: (0.45, 0.5, 0.6, 1)
                                                bold: True
                                                size_hint_y: None
                                                height: 10
                                                text_size: self.size
                                                halign: 'left'
                                            BoxLayout:
                                                orientation: 'horizontal'
                                                spacing: 8
                                                # Red selection
                                                HoverButton:
                                                    size_hint: None, None
                                                    size: 24, 24
                                                    background_normal: ''
                                                    background_color: (1, 0.2, 0.2, 1)
                                                    canvas.after:
                                                        Color:
                                                            rgba: (1, 1, 1, 1) if root.scroll_color == 'r' else (1, 1, 1, 0)
                                                        Line:
                                                            circle: (self.center_x, self.center_y, 11)
                                                            width: 2
                                                    on_release: root.scroll_color = 'r'
                                                # Blue selection
                                                HoverButton:
                                                    size_hint: None, None
                                                    size: 24, 24
                                                    background_normal: ''
                                                    background_color: (0.2, 0.6, 1, 1)
                                                    canvas.after:
                                                        Color:
                                                            rgba: (1, 1, 1, 1) if root.scroll_color == 'b' else (1, 1, 1, 0)
                                                        Line:
                                                            circle: (self.center_x, self.center_y, 11)
                                                            width: 2
                                                    on_release: root.scroll_color = 'b'
                                                # Purple selection
                                                HoverButton:
                                                    size_hint: None, None
                                                    size: 24, 24
                                                    background_normal: ''
                                                    background_color: (0.7, 0.2, 1, 1)
                                                    canvas.after:
                                                        Color:
                                                            rgba: (1, 1, 1, 1) if root.scroll_color == 'p' else (1, 1, 1, 0)
                                                        Line:
                                                            circle: (self.center_x, self.center_y, 11)
                                                            width: 2
                                                    on_release: root.scroll_color = 'p'

                                        # Direction Selector Column
                                        BoxLayout:
                                            orientation: 'vertical'
                                            spacing: 4
                                            Label:
                                                text: "SCROLL DIRECTION"
                                                font_size: '8sp'
                                                color: (0.45, 0.5, 0.6, 1)
                                                bold: True
                                                size_hint_y: None
                                                height: 10
                                                text_size: self.size
                                                halign: 'left'
                                            BoxLayout:
                                                orientation: 'horizontal'
                                                spacing: 4
                                                # Left
                                                HoverButton:
                                                    text: "L"
                                                    font_size: '9sp'
                                                    bold: True
                                                    background_normal: ''
                                                    background_color: (0, 0.45, 0.8, 1) if root.scroll_dir == 'l' else (30/255, 38/255, 58/255, 1)
                                                    on_release: root.scroll_dir = 'l'
                                                # Right
                                                HoverButton:
                                                    text: "R"
                                                    font_size: '9sp'
                                                    bold: True
                                                    background_normal: ''
                                                    background_color: (0, 0.45, 0.8, 1) if root.scroll_dir == 'r' else (30/255, 38/255, 58/255, 1)
                                                    on_release: root.scroll_dir = 'r'
                                                # Up
                                                HoverButton:
                                                    text: "U"
                                                    font_size: '9sp'
                                                    bold: True
                                                    background_normal: ''
                                                    background_color: (0, 0.45, 0.8, 1) if root.scroll_dir == 'u' else (30/255, 38/255, 58/255, 1)
                                                    on_release: root.scroll_dir = 'u'
                                                # Down
                                                HoverButton:
                                                    text: "D"
                                                    font_size: '9sp'
                                                    bold: True
                                                    background_normal: ''
                                                    background_color: (0, 0.45, 0.8, 1) if root.scroll_dir == 'd' else (30/255, 38/255, 58/255, 1)
                                                    on_release: root.scroll_dir = 'd'

                                # Patterns Section
                                Label:
                                    text: "PRESET PATTERNS LIBRARY"
                                    font_size: '10sp'
                                    bold: True
                                    color: (0.2, 0.65, 1, 1)
                                    size_hint_y: None
                                    height: 14
                                    text_size: self.size
                                    halign: 'left'

                                GridLayout:
                                    cols: 2
                                    spacing: 10
                                    size_hint_y: None
                                    height: 154
                                    
                                    PresetCard:
                                        text: "HEART"
                                        icon: Icons.heart
                                        pattern_string: "000000000rr00rr0rrrrrrrrrrrrrrrr0rrrrrr000rrrr0000rr000000000000"
                                        grid_id: led_grid
                                        color_theme: (1, 0.2, 0.3, 1)
                                        
                                    PresetCard:
                                        text: "SMILE"
                                        icon: Icons.emoticon_happy
                                        pattern_string: "0000000000rrrr000r0000r0r0rrrr0rr0rrrr0rr00000r000rrrr0000000000"
                                        grid_id: led_grid
                                        color_theme: (1, 0.7, 0.1, 1)
                                        
                                    PresetCard:
                                        text: "ARROW"
                                        icon: Icons.arrow_right
                                        pattern_string: "0000r000000rr00000rrrr000000r0000000r0000000r0000000r00000000000"
                                        grid_id: led_grid
                                        color_theme: (0.2, 0.8, 0.4, 1)
                                        
                                    PresetCard:
                                        text: "CROSS"
                                        icon: Icons.close_circle
                                        pattern_string: "r000000r0r0000r000r00r00000rr000000rr00000r00r000r0000r0r000000r"
                                        grid_id: led_grid
                                        color_theme: (0.9, 0.3, 0.3, 1)
                                        
                                    PresetCard:
                                        text: "SQUARE"
                                        icon: Icons.circle_outline
                                        pattern_string: "bbbbbbbbb000000bb000000bb000000bb000000bb000000bb000000bbbbbbbbb"
                                        grid_id: led_grid
                                        color_theme: (0.7, 0.2, 1, 1)
                                        
                                    PresetCard:
                                        text: "GOOSE"
                                        icon: Icons.quadcopter
                                        pattern_string: "0000000000rr00000000rr0000000rr0000000rr0rr000rr0rr00rr000000000"
                                        grid_id: led_grid
                                        color_theme: (0.7, 0.2, 1, 1)
                                
                                Widget: # Spacer

            # ─── MEDIA VIEWER OVERLAY ────────────────
            BoxLayout:
                id: media_viewer
                active: False
                source: ""
                opacity: 1 if self.active else 0
                disabled: not self.active
                pos_hint: {'x': 0, 'y': 0}
                size_hint: 1, 1
                orientation: 'vertical'
                canvas.before:
                    Color:
                        rgba: (0, 0, 0, 0.95)
                    Rectangle:
                        pos: self.pos
                        size: self.size
                
                BoxLayout:
                    size_hint_y: None
                    height: 50
                    padding: [20, 5]
                    spacing: 20
                    
                    Label:
                        text: os.path.basename(root.ids.media_viewer.source) if root.ids.media_viewer.source else ""
                        bold: True
                        halign: 'left'
                        text_size: self.size
                    
                    HoverButton:
                        text: "[font=Icons]" + Icons.open_in_new + "[/font]  SYSTEM VIEWER"
                        size_hint_x: None
                        width: 160
                        on_release: root.open_in_system_viewer()
                    
                    HoverButton:
                        text: Icons.close + " CLOSE"
                        font_name: 'Icons'
                        size_hint_x: None
                        width: 100
                        on_release: root.close_viewer()

                BoxLayout:
                    id: viewer_content
                    padding: 40

    # ===== BOTTOM ACTION BAR =====
    BoxLayout:
        opacity: 1 if (root.selection_mode and root.active_nav in ["All Media", "Photos", "Videos", "Favorites"]) else 0
        disabled: not (root.selection_mode and root.active_nav in ["All Media", "Photos", "Videos", "Favorites"])
        orientation: 'horizontal'
        size_hint: None, None
        size: 580, 50
        pos_hint: {"center_x": 0.5, "y": 0.02}
        padding: [20, 8, 20, 8]
        spacing: 20

        canvas.before:
            Color:
                rgba: (18/255, 24/255, 38/255, 0.95)
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [25]
            Color:
                rgba: (0.15, 0.22, 0.35, 0.6)
            Line:
                rounded_rectangle: [self.x, self.y, self.width, self.height, 25]
                width: 1

        # Selected items count
        BoxLayout:
            orientation: 'horizontal'
            size_hint_x: None
            width: 100
            spacing: 8

            Label:
                text: Icons.check_circle
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.2, 0.7, 1, 1)
                size_hint_x: None
                width: 20

            BoxLayout:
                orientation: 'vertical'
                Label:
                    text: "Items"
                    font_size: '11sp'
                    bold: True
                    color: (1, 1, 1, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'bottom'
                Label:
                    text: "Selected"
                    font_size: '10sp'
                    color: (0.5, 0.55, 0.65, 1)
                    text_size: self.size
                    halign: 'left'
                    valign: 'top'

        VerticalDivider:
            size_hint_y: 0.6
            pos_hint: {"center_y": 0.5}

        # Download
        ClickableBox:
            on_release: root.download_selected()
            orientation: 'horizontal'
            size_hint_x: None
            width: 90
            spacing: 6

            Label:
                text: Icons.download
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.2, 0.65, 1, 1)
                size_hint_x: None
                width: 20

            Label:
                text: "Download"
                font_size: '12sp'
                color: (0.2, 0.65, 1, 1)

        # Favorite
        ClickableBox:
            on_release: root.favorite_selected()
            orientation: 'horizontal'
            size_hint_x: None
            width: 80
            spacing: 6

            Label:
                text: Icons.star
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.85, 0.85, 0.9, 1)
                size_hint_x: None
                width: 20

            Label:
                text: "Favorite"
                font_size: '12sp'
                color: (0.85, 0.85, 0.9, 1)

        # Delete
        ClickableBox:
            on_release: root.delete_selected()
            orientation: 'horizontal'
            size_hint_x: None
            width: 70
            spacing: 6

            Label:
                text: Icons.delete
                font_name: 'Icons'
                font_size: '16sp'
                color: (0.9, 0.3, 0.3, 1)
                size_hint_x: None
                width: 20

            Label:
                text: "Delete"
                font_size: '12sp'
                color: (0.9, 0.3, 0.3, 1)

        # Close (X)
        HoverButton:
            text: Icons.close
            font_name: 'Icons'
            font_size: '18sp'
            color: (0.5, 0.55, 0.65, 1)
            background_normal: ''
            background_color: (0, 0, 0, 0)
            size_hint_x: None
            width: 28
            on_release: app.close_media_gallery()

    # ===== CLOSE BUTTON (top-right) =====
    HoverButton:
        text: Icons.close
        font_name: 'Icons'
        font_size: '20sp'
        color: (0.6, 0.65, 0.75, 1) if self.state == 'normal' else (1, 1, 1, 1)
        background_normal: ''
        background_color: (0, 0, 0, 0)
        size_hint: None, None
        size: 36, 36
        pos_hint: {"right": 0.995, "top": 0.99}
        on_release: app.close_media_gallery()
