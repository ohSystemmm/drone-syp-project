#:kivy 2.0.0
#:import utils kivy.utils
#:import Icons ui.icons.Icons
#:set margin 10

<FlightModeButton@ButtonBehavior+BoxLayout>:
    is_active: False
    mode_id: ""
    text: ""
    text_color: (0.9, 0.95, 1, 1)
    
    size_hint_y: None
    height: 52
    padding: [20, 0, 20, 0]
    spacing: 16
    
    canvas.before:
        Color:
            rgba: (20/255, 60/255, 80/255, 0.6) if self.is_active else ((1, 1, 1, 0.1) if self.state == 'down' else (1, 1, 1, 0.03))
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [10]
        Color:
            rgba: (30/255, 100/255, 130/255, 1) if self.is_active else (1, 1, 1, 0.08)
        Line:
            rounded_rectangle: [self.x, self.y, self.width, self.height, 10]
            width: 1.2
            
    Label:
        text: root.text
        markup: True
        font_size: '15sp'
        bold: True
        color: root.text_color
        text_size: self.size
        halign: 'left'
        valign: 'middle'

<EmergencyButton@ButtonBehavior+Label>:
    size_hint_x: None
    width: 28
    text: Icons.alert_octagon
    font_name: 'Icons'
    color: (1, 1, 1, 1)
    font_size: '14sp'
    canvas.before:
        Color:
            rgba: (0.9, 0.3, 0.3, 1) if self.state == 'normal' else (0.7, 0.2, 0.2, 1)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [6]
            
<FlightMenu>:
    size_hint: None, None
    width: 300
    height: root.minimum_height
    padding: [22, 24, 22, 22]
    spacing: 12
    orientation: 'vertical'

    canvas.before:
        Color:
            rgba: (24/255, 34/255, 40/255, 0.95)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [16]

    BoxLayout:
        orientation: 'vertical'
        # This constraint forces the minimum width of FlightMenu to be 256 + 44 = 300
        size_hint: None, None
        size: 256, self.minimum_height
        spacing: 4
        
        Label:
            text: "Flight Modes"
            size_hint_y: None
            height: 24
            font_size: '18sp'
            bold: True
            color: (1, 1, 1, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            
        Label:
            text: "AUTOMATED MANEUVERS"
            size_hint_y: None
            height: 16
            font_size: '11sp'
            color: (0.6, 0.7, 0.8, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            
    Widget:
        size_hint_y: None
        height: 6

    FlightModeButton:
        text: "[font=Icons]" + Icons.target + "[/font]  Autopilot"
        mode_id: "Autopilot"
        is_active: app.autopilot.active
        on_release: app.on_action("TOGGLE_AUTOPILOT")

    FlightModeButton:
        text: "[font=Icons]" + Icons.sync + "[/font]  360 Flip"
        mode_id: "360 Flip"
        is_active: root.active_mode == self.mode_id
        on_release: root.on_mode_select(self.mode_id)
        
    FlightModeButton:
        text: "[font=Icons]" + Icons.rotate_right + "[/font]  Circle"
        mode_id: "Circle"
        is_active: root.active_mode == self.mode_id
        on_release: root.on_mode_select(self.mode_id)
        
    FlightModeButton:
        text: "[font=Icons]" + Icons.arrow_top_right + "[/font]  Up & Out"
        mode_id: "Up & Out"
        is_active: root.active_mode == self.mode_id
        on_release: root.on_mode_select(self.mode_id)
        
    FlightModeButton:
        text: "[font=Icons]" + Icons.arrow_up_down + "[/font]  Bounce"
        mode_id: "Bounce"
        is_active: root.active_mode == self.mode_id
        on_release: root.on_mode_select(self.mode_id)

    Widget:
        size_hint_y: None
        height: 12

    Widget:
        size_hint_y: None
        height: 1
        canvas:
            Color:
                rgba: (1, 1, 1, 0.1)
            Rectangle:
                pos: self.x, self.y
                size: self.width, 1

    Widget:
        size_hint_y: None
        height: 12

    BoxLayout:
        size_hint_y: None
        height: 28
        orientation: 'horizontal'
        
        Label:
            text: "EMERGENCY LAND"
            font_size: '12sp'
            bold: True
            color: (0.6, 0.7, 0.8, 1)
            text_size: self.size
            halign: 'left'
            valign: 'middle'
            
        EmergencyButton:
            on_release: app.on_action("Emergency Land")

    Widget:
        # A stretchy spacer to push everything to the top when height is stretched.
        size_hint_y: 1
